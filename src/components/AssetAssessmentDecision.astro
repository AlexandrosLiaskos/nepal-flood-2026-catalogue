---
import BaseLayout from "../layouts/BaseLayout.astro";
import { assessmentCorrections, type AssessmentAsset, type AssessmentResource } from "../lib/assessment";
import { fieldState, formatDate, humanize, withBase } from "../lib/format";

interface Props { assessment: AssessmentAsset; parent?: AssessmentResource; }
const { assessment, parent } = Astro.props;
const title = assessment.reviewed_title || assessment.original_title || assessment.asset_id;
const outcome = assessment.eligibility_outcome === "exclude" ? "Excluded from the assessed asset index" : fieldState(assessment.eligibility_outcome);
const corrections = assessmentCorrections(assessment.metadata_corrections);
const detailText = (value: unknown) => typeof value === "string" ? value : value ? JSON.stringify(value) : "Not stated in the assessment ledger";
const sources = [...new Set([assessment.asset_url, ...assessment.source_evidence].filter(Boolean))].filter((url) => {
  try { return ["http:", "https:"].includes(new URL(url).protocol); } catch { return false; }
});
const parentPath = parent?.eligibility_outcome === "include" ? `resources/${parent.resource_id}/` : parent ? `under-review/${parent.resource_id}/` : "assessment/";
---

<BaseLayout title={title} description={`${title}. ${outcome}.`} noindex>
  <header class="page-head page-head--compact">
    <div class="container decision-container">
      <p><a href={withBase("assessment/")}>Back to assessment decisions</a></p>
      <h1>{title}</h1>
      <p class="decision-outcome">{outcome}</p>
    </div>
  </header>
  <article class="container decision-container decision-page">
    <dl class="decision-details">
      <div><dt>Assessment date</dt><dd>{formatDate(assessment.assessment_date)}</dd></div>
      <div><dt>Decision</dt><dd>{humanize(assessment.specific_decision)}</dd></div>
      <div><dt>Reason</dt><dd>{assessment.reason || "Not stated in the assessment ledger"}</dd></div>
      <div><dt>Information role</dt><dd>{humanize(assessment.information_role)}</dd></div>
      <div><dt>Access assessment</dt><dd>{detailText(assessment.access_assessment)}</dd></div>
      <div><dt>Rights assessment</dt><dd>{detailText(assessment.rights_assessment)}</dd></div>
      <div><dt>Scientific validation</dt><dd>{detailText(assessment.scientific_validation)}</dd></div>
      <div><dt>Asset reference</dt><dd>{assessment.asset_id}</dd></div>
      <div><dt>Parent resource</dt><dd>{parent ? <a href={withBase(parentPath)}>{parent.reviewed_title || parent.original_title || parent.resource_id}</a> : assessment.resource_id}</dd></div>
      {assessment.original_title && assessment.original_title !== title && <div><dt>Original title</dt><dd>{assessment.original_title}</dd></div>}
    </dl>
    {corrections.length > 0 && <section aria-labelledby="corrections-heading">
      <h2 id="corrections-heading">Metadata corrections</h2>
      <dl class="decision-details">{corrections.map((row) => <div><dt>{humanize(row.field)}</dt><dd>{row.value}</dd></div>)}</dl>
    </section>}
    {sources.length > 0 && <section aria-labelledby="sources-heading">
      <h2 id="sources-heading">Source evidence</h2>
      <ul>{sources.map((url, index) => <li><a href={url} rel="noreferrer">Source {index + 1}: {new URL(url).hostname}</a></li>)}</ul>
    </section>}
    <p class="ledger-link"><a href={withBase("data/assessment-assets.csv")} download>Download the full asset decision ledger</a></p>
  </article>
</BaseLayout>

<style>
  .decision-container { max-width: 64rem; }
  .decision-container h1 { max-width: 34ch; overflow-wrap: anywhere; }
  .decision-outcome { color: var(--ink-soft); font-weight: 650; }
  .decision-page { padding-block: 2rem 5rem; }
  .decision-page section { margin-top: 2.5rem; }
  .decision-details { margin: 0; border-top: 1px solid var(--rule); }
  .decision-details > div { display: grid; grid-template-columns: minmax(10rem, 0.25fr) minmax(0, 1fr); gap: 1.5rem; padding-block: 1rem; border-bottom: 1px solid var(--rule); }
  .decision-details dt { font-size: 0.85rem; color: var(--ink-soft); font-weight: 650; }
  .decision-details dd { margin: 0; overflow-wrap: anywhere; }
  .ledger-link { margin-top: 2.5rem; }
  @media (max-width: 42rem) { .decision-details > div { grid-template-columns: 1fr; gap: 0.35rem; } }
</style>
