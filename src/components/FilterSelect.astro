---
interface FilterOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  options: FilterOption[];
}

const { id, name, label, options } = Astro.props;
const labelId = `${id}-label`;
const triggerId = `${id}-trigger`;
const valueId = `${id}-value`;
const listboxId = `${id}-listbox`;
---

<div class="filter-select" data-filter-select>
  <label id={labelId} for={id}>{label}</label>
  <select id={id} name={name} class="filter-select__native" data-filter-select-native>
    {options.map((option) => <option value={option.value}>{option.label}</option>)}
  </select>
  <button
    id={triggerId}
    class="filter-select__trigger"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-labelledby={`${labelId} ${valueId}`}
    data-filter-select-trigger
    hidden
  >
    <span id={valueId} class="filter-select__value" data-filter-select-value>{options[0]?.label}</span>
    <svg class="filter-select__chevron" viewBox="0 0 16 16" aria-hidden="true">
      <path d="m3.5 6 4.5 4.5L12.5 6"></path>
    </svg>
  </button>
  <div class="filter-select__popover" data-filter-select-popover hidden>
    <div
      id={listboxId}
      class="filter-select__listbox"
      role="listbox"
      tabindex="-1"
      aria-labelledby={labelId}
      data-filter-select-listbox
    >
      {options.map((option, index) => (
        <div
          id={`${id}-option-${index}`}
          class="filter-select__option"
          role="option"
          aria-selected={index === 0 ? "true" : "false"}
          data-filter-select-option
          data-value={option.value}
        >
          <span>{option.label}</span>
          <svg class="filter-select__check" viewBox="0 0 16 16" aria-hidden="true">
            <path d="m3 8.3 3 3L13 4.7"></path>
          </svg>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const selectMenus = [...document.querySelectorAll<HTMLElement>("[data-filter-select]")];
  let openMenu: HTMLElement | null = null;
  const typeaheadTimers = new WeakMap<HTMLElement, number>();

  function parts(menu: HTMLElement) {
    return {
      native: menu.querySelector<HTMLSelectElement>("[data-filter-select-native]"),
      trigger: menu.querySelector<HTMLButtonElement>("[data-filter-select-trigger]"),
      value: menu.querySelector<HTMLElement>("[data-filter-select-value]"),
      popover: menu.querySelector<HTMLElement>("[data-filter-select-popover]"),
      listbox: menu.querySelector<HTMLElement>("[data-filter-select-listbox]"),
      options: [...menu.querySelectorAll<HTMLElement>("[data-filter-select-option]")],
    };
  }

  function syncMenu(menu: HTMLElement) {
    const { native, value, options } = parts(menu);
    if (!native || !value) return;

    const selectedIndex = Math.max(0, native.selectedIndex);
    value.textContent = native.options[selectedIndex]?.textContent ?? "";
    for (const [index, option] of options.entries()) {
      option.setAttribute("aria-selected", String(index === selectedIndex));
    }
  }

  function setActiveOption(menu: HTMLElement, index: number, scroll = true) {
    const { listbox, options } = parts(menu);
    if (!listbox || options.length === 0) return;

    const nextIndex = Math.max(0, Math.min(index, options.length - 1));
    for (const [optionIndex, option] of options.entries()) {
      if (optionIndex === nextIndex) option.dataset.active = "true";
      else delete option.dataset.active;
    }
    menu.dataset.activeIndex = String(nextIndex);
    listbox.setAttribute("aria-activedescendant", options[nextIndex].id);
    if (scroll) options[nextIndex].scrollIntoView({ block: "nearest" });
  }

  function positionMenu(menu: HTMLElement) {
    const { trigger, popover } = parts(menu);
    if (!trigger || !popover || popover.hidden) return;

    const triggerRect = trigger.getBoundingClientRect();
    const spaceBelow = window.innerHeight - triggerRect.bottom - 16;
    const spaceAbove = triggerRect.top - 16;
    const opensUp = spaceBelow < 220 && spaceAbove > spaceBelow;
    const availableHeight = Math.max(140, opensUp ? spaceAbove : spaceBelow);
    const expectedWidth = Math.min(352, window.innerWidth - 32);

    menu.classList.toggle("filter-select--up", opensUp);
    menu.classList.toggle("filter-select--align-end", triggerRect.left + expectedWidth > window.innerWidth - 16);
    popover.style.setProperty("--filter-select-available-height", `${availableHeight}px`);
  }

  function closeSelectMenu(menu: HTMLElement, restoreFocus = false) {
    const { trigger, popover } = parts(menu);
    if (!trigger || !popover) return;

    menu.classList.remove("filter-select--open", "filter-select--up", "filter-select--align-end");
    trigger.setAttribute("aria-expanded", "false");
    popover.hidden = true;
    delete menu.dataset.activeIndex;
    if (openMenu === menu) openMenu = null;
    if (restoreFocus) trigger.focus();
  }

  function openSelectMenu(menu: HTMLElement, edge?: "first" | "last") {
    if (openMenu && openMenu !== menu) closeSelectMenu(openMenu);

    const { native, trigger, popover, listbox, options } = parts(menu);
    if (!native || !trigger || !popover || !listbox || options.length === 0) return;

    popover.hidden = false;
    menu.classList.add("filter-select--open");
    trigger.setAttribute("aria-expanded", "true");
    openMenu = menu;
    positionMenu(menu);

    const selectedIndex = Math.max(0, native.selectedIndex);
    setActiveOption(menu, edge === "first" ? 0 : edge === "last" ? options.length - 1 : selectedIndex, false);
    requestAnimationFrame(() => {
      listbox.focus({ preventScroll: true });
      options[Number(menu.dataset.activeIndex) || 0]?.scrollIntoView({ block: "nearest" });
    });
  }

  function chooseOption(menu: HTMLElement, option: HTMLElement) {
    const { native, options } = parts(menu);
    if (!native) return;

    const optionIndex = options.indexOf(option);
    if (optionIndex < 0) return;
    native.value = option.dataset.value ?? "";
    syncMenu(menu);
    native.dispatchEvent(new Event("change", { bubbles: true }));
    closeSelectMenu(menu, true);
  }

  function moveActiveOption(menu: HTMLElement, amount: number) {
    const { options } = parts(menu);
    if (options.length === 0) return;
    const current = Number(menu.dataset.activeIndex) || 0;
    setActiveOption(menu, (current + amount + options.length) % options.length);
  }

  function useTypeahead(menu: HTMLElement, key: string) {
    const { options } = parts(menu);
    const previous = menu.dataset.typeahead ?? "";
    const query = `${previous}${key}`.toLocaleLowerCase("en");
    menu.dataset.typeahead = query;

    const oldTimer = typeaheadTimers.get(menu);
    if (oldTimer) window.clearTimeout(oldTimer);
    typeaheadTimers.set(menu, window.setTimeout(() => delete menu.dataset.typeahead, 650));

    const start = (Number(menu.dataset.activeIndex) || 0) + 1;
    const ordered = [...options.slice(start), ...options.slice(0, start)];
    const match = ordered.find((option) => option.textContent?.trim().toLocaleLowerCase("en").startsWith(query));
    if (match) setActiveOption(menu, options.indexOf(match));
  }

  for (const menu of selectMenus) {
    if (menu.dataset.enhanced === "true") continue;
    const { native, trigger, listbox, options } = parts(menu);
    if (!native || !trigger || !listbox) continue;

    menu.dataset.enhanced = "true";
    trigger.hidden = false;
    native.tabIndex = -1;
    native.setAttribute("aria-hidden", "true");
    const label = document.getElementById(`${native.id}-label`);
    if (label instanceof HTMLLabelElement) label.htmlFor = trigger.id;
    syncMenu(menu);

    trigger.addEventListener("click", () => {
      if (openMenu === menu) closeSelectMenu(menu);
      else openSelectMenu(menu);
    });

    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        openSelectMenu(menu);
      } else if (event.key === "Home" || event.key === "End") {
        event.preventDefault();
        openSelectMenu(menu, event.key === "Home" ? "first" : "last");
      }
    });

    listbox.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        moveActiveOption(menu, 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        moveActiveOption(menu, -1);
      } else if (event.key === "Home" || event.key === "End") {
        event.preventDefault();
        setActiveOption(menu, event.key === "Home" ? 0 : options.length - 1);
      } else if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        const active = options[Number(menu.dataset.activeIndex) || 0];
        if (active) chooseOption(menu, active);
      } else if (event.key === "Escape") {
        event.preventDefault();
        closeSelectMenu(menu, true);
      } else if (event.key === "Tab") {
        closeSelectMenu(menu);
      } else if (event.key.length === 1 && !event.altKey && !event.ctrlKey && !event.metaKey) {
        useTypeahead(menu, event.key);
      }
    });

    listbox.addEventListener("pointermove", (event) => {
      const option = (event.target as Element).closest<HTMLElement>("[data-filter-select-option]");
      if (option) setActiveOption(menu, options.indexOf(option), false);
    });

    listbox.addEventListener("click", (event) => {
      const option = (event.target as Element).closest<HTMLElement>("[data-filter-select-option]");
      if (option) chooseOption(menu, option);
    });

    native.addEventListener("change", () => syncMenu(menu));
    native.form?.addEventListener("reset", () => requestAnimationFrame(() => syncMenu(menu)));
  }

  document.addEventListener("pointerdown", (event) => {
    if (openMenu && !openMenu.contains(event.target as Node)) closeSelectMenu(openMenu);
  });

  window.addEventListener("resize", () => {
    if (openMenu) positionMenu(openMenu);
  });

  const syncAllMenus = () => selectMenus.forEach(syncMenu);
  if (document.readyState === "complete") syncAllMenus();
  else window.addEventListener("load", syncAllMenus, { once: true });
</script>

<style>
  .filter-select {
    position: relative;
    min-width: 0;
  }

  .filter-select label {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .filter-select__native {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 2.42rem;
    padding: 0.38rem 2rem 0.38rem 0.55rem;
    overflow: hidden;
    font-size: 0.88rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .filter-select[data-enhanced="true"] .filter-select__native {
    position: absolute;
    width: 1px;
    height: 1px;
    min-height: 0;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .filter-select__trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    min-width: 0;
    min-height: 2.42rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.15rem;
    background: var(--surface);
    color: var(--ink);
    padding: 0.38rem 0.55rem;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.25;
    text-align: left;
  }

  .filter-select__trigger:hover {
    border-color: var(--teal);
    background: var(--surface);
    color: var(--ink);
  }

  .filter-select--open {
    z-index: 40;
  }

  .filter-select--open .filter-select__trigger {
    border-color: var(--teal-dark);
  }

  .filter-select__value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .filter-select__chevron {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 140ms ease-out;
  }

  .filter-select--open .filter-select__chevron {
    transform: rotate(180deg);
  }

  .filter-select__popover {
    --filter-select-available-height: 18rem;
    position: absolute;
    z-index: 50;
    top: calc(100% + 0.3rem);
    left: 0;
    width: max(100%, min(19rem, calc(100vw - 2rem)));
    max-width: calc(100vw - 2rem);
    border: 1px solid var(--rule-strong);
    border-radius: 0.2rem;
    background: var(--surface);
    box-shadow: 0 0.75rem 1.8rem rgba(21, 40, 58, 0.13);
    padding: 0.24rem;
  }

  .filter-select--align-end .filter-select__popover {
    right: 0;
    left: auto;
  }

  .filter-select--up .filter-select__popover {
    top: auto;
    bottom: calc(100% + 0.3rem);
  }

  .filter-select__listbox {
    max-height: min(18rem, calc(var(--filter-select-available-height) - 0.6rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--rule-strong) transparent;
    scrollbar-width: thin;
  }

  .filter-select__listbox::-webkit-scrollbar {
    width: 0.45rem;
  }

  .filter-select__listbox::-webkit-scrollbar-thumb {
    border: 0.12rem solid transparent;
    border-radius: 999px;
    background: var(--rule-strong);
    background-clip: padding-box;
  }

  .filter-select__option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.35rem;
    border-radius: 0.12rem;
    padding: 0.48rem 0.55rem;
    color: var(--ink);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .filter-select__option[data-active="true"] {
    background: var(--surface-muted);
  }

  .filter-select__option[aria-selected="true"] {
    color: var(--teal-dark);
    font-weight: 650;
  }

  .filter-select__check {
    width: 1rem;
    height: 1rem;
    opacity: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .filter-select__option[aria-selected="true"] .filter-select__check {
    opacity: 1;
  }

  @media (pointer: coarse) {
    .filter-select__native,
    .filter-select__trigger {
      min-height: 2.75rem;
      padding-block: 0.5rem;
      font-size: 1rem;
    }

    .filter-select__option {
      min-height: 2.75rem;
      padding-block: 0.62rem;
      font-size: 1rem;
    }
  }

  @media (max-width: 42rem) {
    .filter-select__popover {
      width: 100%;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-select__chevron {
      transition: none;
    }
  }
</style>
