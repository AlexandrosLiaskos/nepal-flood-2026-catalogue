---
import { parseBoundingBox } from "../lib/data";

interface Props {
  bbox: string | null | undefined;
  label: string;
}

const { bbox, label } = Astro.props;
const bounds = parseBoundingBox(bbox ?? null);
---

{bounds && (
  <button
    class="map-extent-trigger"
    type="button"
    aria-haspopup="dialog"
    data-map-bounds={JSON.stringify(bounds)}
    data-map-label={label}
  >
    <span>View in map</span>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5"></path>
    </svg>
  </button>
)}

<style>
  .map-extent-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    min-height: auto;
    margin-left: 0.7rem;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    color: var(--teal-dark);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: inherit;
    text-decoration: underline;
    text-decoration-thickness: 0.065em;
    text-underline-offset: 0.18em;
  }

  .map-extent-trigger:hover {
    color: var(--teal);
  }

  .map-extent-trigger svg {
    width: 0.9rem;
    height: 0.9rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .map-extent-trigger:hover svg {
    transform: translateX(0.12rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .map-extent-trigger svg {
      transition: none;
    }
  }
</style>
