    color: var(--ink);
    font-weight: 650;
  }

  .eligibility-section {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .eligibility-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: 64rem;
    margin-top: 1.6rem;
  }

  .eligibility-grid ul {
    margin: 0;
    padding-left: 1.15rem;
  }

  .eligibility-grid li + li {
    margin-top: 0.55rem;
  }

  .authors-section {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .author-line {
    max-width: 72ch;
    margin: 0;
    color: var(--ink);
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .author-line a {
    color: inherit;
    font-weight: 600;
    text-decoration-color: #9fb8b7;
  }

  .author-line sup,
  .affiliation-list sup {
    margin-left: 0.08em;
    font-size: 0.7em;
    line-height: 0;
    vertical-align: super;
  }

  .affiliation-list {
    max-width: 78ch;
    margin: 0.75rem 0 0;
    padding: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
    list-style: none;
  }

  .affiliation-list li + li {
    margin-top: 0.3rem;
  }

  @media (max-width: 46rem) {
    .about-head {
      padding-block: 3rem 2.75rem;
    }

    .about-section {
      padding-block: 3rem;
    }

    .standards-list > div,
    .reading-list,
    .classification-list,
    .eligibility-grid {
      grid-template-columns: 1fr;
    }

    .standards-list > div {
      gap: 0.4rem;
      padding-block: 1.2rem;
    }

    .reading-list,
    .classification-list {
      gap: 1.5rem;
    }

    .authors-section {
      padding-top: 3.5rem;
    }
  }
</style>
