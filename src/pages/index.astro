---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicData } from "../lib/data";
import { formatDate, withBase } from "../lib/format";

const { status } = await getPublicData();
const siteTitle = "Public Data Resources for the 26 August 2026 Nepal Hazard Cascade";
const description = "A living scoping review and data catalogue connecting pre-event baselines, event observations and subsequent analyses to support research on the 26 August 2026 Nepal hazard cascade.";
const catalogueUrl = new URL(withBase(""), Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  name: siteTitle,
  description,
  url: catalogueUrl,
  dateModified: "2026-10-03",
  citation: "https://doi.org/10.5281/zenodo.23034746",
  inLanguage: "en",
  creator: [
    { "@type": "Person", name: "Alexandros Liaskos" },
    { "@type": "Person", name: "Niki Evelpidou" },
    { "@type": "Person", name: "Evangelos Spyrou" },
    { "@type": "Person", name: "Nitesh Khadka" },
  ],
  license: "https://creativecommons.org/licenses/by/4.0/",
};
---

<BaseLayout description={description} jsonLd={jsonLd}>
  <header class="page-head home-hero">
    <div class="hero-image" aria-hidden="true">
      <picture class="hero-slide hero-slide--event is-active" data-hero-slide>
        <source
          srcset={`${withBase("images/rasuwa-flood-betrawati-2026-1024.jpg")} 1024w, ${withBase("images/rasuwa-flood-betrawati-2026.jpg")} 1600w`}
          sizes="100vw"
          type="image/jpeg"
        />
        <img
          src={withBase("images/rasuwa-flood-betrawati-2026.jpg")}
          width="1600"
          height="739"
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <picture class="hero-slide hero-slide--mountain" data-hero-slide>
        <source
          srcset={`${withBase("images/langtang-lirung-hero-960.webp")} 960w, ${withBase("images/langtang-lirung-hero-1920.webp")} 1920w`}
          sizes="100vw"
          type="image/webp"
        />
        <img
          src={withBase("images/langtang-lirung-hero-1920.webp")}
          width="1920"
          height="1078"
          alt=""
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      </picture>
    </div>
    <div class="container hero-article">
      <p class="hero-status"><span>Archived release:</span><time datetime="2026-09-28">28 September 2026</time></p>
      <h1>{siteTitle}</h1>
      <p class="hero-subtitle">A living scoping review and data catalogue connecting pre-event baselines, event observations and subsequent analyses to support research on the 26 August 2026 Nepal hazard cascade (<a href="https://www.preprints.org/manuscript/202610.0448">Preprint</a>).</p>

      <nav class="hero-directory" aria-label="Catalogue indexes">
        <a class="hero-directory-link hero-directory-link--primary" href={withBase("resources/")}>
          <span class="hero-directory-copy">
            <span class="hero-directory-title">Resources</span>
            <span class="hero-directory-note">Catalogue entries and their review status.</span>
          </span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path>
          </svg>
        </a>
        <a class="hero-directory-link" href={withBase("assets/")}>
          <span class="hero-directory-copy">
            <span class="hero-directory-title">Assets</span>
            <span class="hero-directory-note">Files, layers, tables, and services across 7 modalities.</span>
          </span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path>
          </svg>
        </a>
        <a class="hero-directory-link" href={withBase("searches/")}>
          <span class="hero-directory-copy">
            <span class="hero-directory-title">Searches</span>
            <span class="hero-directory-note">Search strategies, dates, and records found.</span>
          </span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path>
          </svg>
        </a>
      </nav>

      <nav class="hero-actions" aria-label="Related pages">
        <a class="hero-action-link" href="https://www.preprints.org/manuscript/202610.0448"><span>Preprint</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14 14 6M8 6h6v6"></path></svg></a>
        <a class="hero-action-link" href="https://doi.org/10.5281/zenodo.23034746"><span>Archived release (Zenodo)</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14 14 6M8 6h6v6"></path></svg></a>
        <a class="hero-action-link" href="https://evelpidou.nkua.cloud/Nepal-Flood-2026/">
          <span>Open WebGIS</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M6 14 14 6M8 6h6v6"></path>
          </svg>
        </a>
        <a class="hero-action-link" href={withBase("about/")}>
          <span>About the review</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 5.5 15.5 10 11 14.5"></path>
          </svg>
        </a>
      </nav>

    </div>
    <p class="hero-credit">
      <span class="hero-credit-item is-active" data-hero-credit>
        Image: <a href="https://www.flickr.com/photos/caritasinternational/55499281148">Flood damage at Betrawati, Rasuwa</a> (2026), Caritas Nepal / Caritas International; free editorial reproduction; cropped.
      </span>
      <span class="hero-credit-item" data-hero-credit aria-hidden="true">
        Image: <a href="https://commons.wikimedia.org/wiki/File:Lirung.jpg">Langtang Lirung from the southeast</a> (2020), <a href="https://www.flickr.com/photos/snikologiannis/49578245901/">Stefanos Nikologianis</a>, <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>; cropped.
      </span>
    </p>
  </header>

  <script>
    const slides = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const credits = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-credit]"));

    if (slides.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let activeIndex = 0;

      window.setInterval(() => {
        slides[activeIndex]?.classList.remove("is-active");
        credits[activeIndex]?.classList.remove("is-active");
        credits[activeIndex]?.setAttribute("aria-hidden", "true");

        activeIndex = (activeIndex + 1) % slides.length;

        slides[activeIndex]?.classList.add("is-active");
        credits[activeIndex]?.classList.add("is-active");
        credits[activeIndex]?.removeAttribute("aria-hidden");
      }, 10000);
    }
  </script>

  <style>
    .home-hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background: var(--paper);
      padding-block: clamp(3.5rem, 7vw, 5.75rem) clamp(3.25rem, 6vw, 4.75rem);
    }

    .hero-image {
      position: absolute;
      z-index: 0;
      inset: 0;
    }

    .hero-slide,
    .hero-image img {
      display: block;
      width: 100%;
      height: 100%;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1.1s ease;
    }

    .hero-slide.is-active {
      opacity: 1;
    }

    .hero-image img {
      object-fit: cover;
      filter: saturate(0.72) contrast(1.06) brightness(0.96);
    }

    .hero-slide--event img {
      object-position: 55% 48%;
      filter: saturate(0.78) contrast(1.03) brightness(0.98);
    }

    .hero-slide--mountain img {
      object-position: 62% 46%;
    }

    .hero-image::after {
      position: absolute;
      content: "";
      inset: 0;
      background:
        linear-gradient(
          90deg,
          rgba(251, 250, 246, 0.96) 0%,
          rgba(251, 250, 246, 0.92) 30%,
          rgba(251, 250, 246, 0.67) 50%,
          rgba(251, 250, 246, 0.24) 68%,
          rgba(251, 250, 246, 0.04) 100%
        ),
        linear-gradient(
          180deg,
          rgba(251, 250, 246, 0.08),
          rgba(251, 250, 246, 0.22)
        );
    }

    .hero-article {
      position: relative;
      z-index: 1;
      max-width: 74rem;
    }

    .home-hero h1 {
      max-width: 22ch;
      font-size: clamp(2.5rem, 4.9vw, 4.2rem);
      line-height: 1.06;
    }

    .hero-subtitle {
      max-width: 61ch;
      margin: 1.3rem 0 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 1.35vw, 1.15rem);
      line-height: 1.48;
    }

    .hero-subtitle a {
      font-weight: 600;
    }

    .hero-directory {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.7rem;
      max-width: 64rem;
      margin-top: 2rem;
    }

    .hero-directory-link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.8rem;
      min-height: 4.65rem;
      border: 1px solid rgba(25, 92, 91, 0.35);
      border-radius: 0.15rem;
      background: rgba(255, 255, 255, 0.88);
      color: var(--ink);
      padding: 0.72rem 0.85rem;
      text-decoration: none;
    }

    .hero-directory-link:hover {
      border-color: var(--teal);
      background: #fff;
      color: var(--teal-dark);
    }

    .hero-directory-link--primary {
      border-color: var(--teal-dark);
      background: var(--teal-dark);
      color: #fff;
    }

    .hero-directory-link--primary:hover {
      border-color: var(--teal);
      background: var(--teal);
      color: #fff;
    }

    .hero-directory-copy,
    .hero-directory-title,
    .hero-directory-note {
      display: block;
    }

    .hero-directory-title {
      font-size: 0.98rem;
      font-weight: 700;
      line-height: 1.25;
    }

    .hero-directory-note {
      margin-top: 0.16rem;
      color: var(--ink-soft);
      font-size: 0.78rem;
      line-height: 1.35;
    }

    .hero-directory-link--primary .hero-directory-note {
      color: rgba(255, 255, 255, 0.84);
    }

    .hero-directory-link svg {
      width: 1.15rem;
      height: 1.15rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.5;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 1.4rem;
      margin-top: 0.85rem;
    }

    .hero-action-link {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      min-height: 2.75rem;
      color: var(--teal-dark);
      font-size: 0.88rem;
      font-weight: 650;
      text-decoration-color: rgba(25, 92, 91, 0.42);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }

    .hero-action-link:hover {
      color: var(--teal);
      text-decoration-color: currentColor;
    }

    .hero-action-link svg {
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.55;
    }

    .hero-status {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      width: fit-content;
      margin: 0 0 0.8rem;
      border: 1px solid rgba(25, 92, 91, 0.28);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--teal-dark);
      padding: 0.24rem 0.6rem;
      font-size: 0.76rem;
      font-weight: 650;
      line-height: 1.3;
    }

    .hero-credit {
      position: absolute;
      z-index: 2;
      right: clamp(0.55rem, 1.2vw, 1rem);
      bottom: 0.45rem;
      max-width: calc(100% - 1.5rem);
      margin: 0;
      padding: 0;
      color: var(--ink-soft);
      font-size: 0.68rem;
      line-height: 1.35;
      text-align: right;
    }

    .hero-credit a {
      color: inherit;
      text-decoration-color: #9fb8b7;
    }

    .hero-credit-item {
      display: none;
    }

    .hero-credit-item.is-active {
      display: inline;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-slide {
        transition: none;
      }
    }

    @media (max-width: 52rem) {
      .home-hero {
        padding-block: 3.25rem 3rem;
      }

      .home-hero h1 {
        max-width: 20ch;
      }

    }

    @media (max-width: 42rem) {
      .home-hero {
        padding-block: 3rem 1.5rem;
      }

      .home-hero h1 {
        max-width: 18ch;
        font-size: clamp(2.1rem, 10vw, 2.65rem);
        line-height: 1.08;
        overflow-wrap: anywhere;
      }

      .hero-subtitle {
        margin-top: 1.35rem;
        font-size: 1rem;
        line-height: 1.62;
      }

      .hero-slide--event img {
        object-position: 58% center;
      }

      .hero-slide--mountain img {
        object-position: 58% center;
      }

      .hero-image::after {
        background: rgba(251, 250, 246, 0.84);
      }

      .hero-credit {
        position: relative;
        right: auto;
        bottom: auto;
        max-width: none;
        margin: 1.8rem 1.25rem 0;
        padding-bottom: 0.35rem;
        text-align: left;
      }

      .hero-directory {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        margin-top: 2.25rem;
      }

      .hero-directory-link--primary {
        grid-column: 1 / -1;
      }

      .hero-directory-link {
        min-height: 4.7rem;
        padding: 0.9rem 1rem;
      }

      .hero-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem 1rem;
        margin-top: 1.2rem;
      }

      .hero-action-link {
        min-width: 0;
      }
    }

    @media (max-width: 32rem) {
      .hero-directory,
      .hero-actions {
        grid-template-columns: 1fr;
      }

      .hero-directory-link--primary {
        grid-column: auto;
      }
    }
  </style>
</BaseLayout>
